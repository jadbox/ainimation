---
import { animationFileUrl } from "../lib/movie";
import type { PartProposals, SegmentVideo, StoryScene } from "../lib/movie";

export interface Props {
  film: string;
  name: string;
  part: number;
  index: number;
  partsCount: number;
  proposals: PartProposals;
  hasStartProposal: boolean;
  hasEndProposal: boolean;
  canUsePreviousSceneFrame: boolean;
  canUseNextSceneFrame: boolean;
  previousFrame: string | null;
  previousStory?: StoryScene;
  previousPart?: number;
  nextFrame: string | null;
  nextStory?: StoryScene;
  nextPart?: number;
  priorSegment?: SegmentVideo | null;
  nextSegment?: SegmentVideo | null;
}

const {
  film,
  name,
  part,
  index,
  proposals,
  hasStartProposal,
  hasEndProposal,
  canUsePreviousSceneFrame,
  canUseNextSceneFrame,
  previousFrame,
  previousStory,
  previousPart,
  nextFrame,
  nextStory,
  nextPart,
  priorSegment,
  nextSegment,
} = Astro.props;

const hasStartOptions =
  hasStartProposal ||
  canUsePreviousSceneFrame ||
  (priorSegment && priorSegment.endThumb);
const hasEndOptions =
  hasEndProposal ||
  canUseNextSceneFrame ||
  (nextSegment && nextSegment.startThumb);
---

<div class="grid gap-5 lg:grid-cols-2">
  {/* START FRAME CARD */}
  <div class="flex flex-col justify-between rounded-xl border border-line bg-ink/30 p-4">
    <div>
      <div class="mb-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-teal-shadow"></span>
          <h3 class="font-display text-sm font-semibold tracking-wide text-amber-soft">
            Add start frame
          </h3>
        </div>
        <span class="font-mono text-[10px] text-muted">
          --frame_start
        </span>
      </div>

      {
        hasStartOptions ? (
          <div
            class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            data-frame-selector="start"
            data-part={part}
          >
            {/* Option: Start Proposals */}
            {hasStartProposal &&
              proposals.start.map((prop) => (
                <div
                  data-tile-container
                  data-value={prop.path}
                  class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
                >
                  <div class="relative">
                    <button
                      type="button"
                      data-preview-image
                      data-src={animationFileUrl(film, name, prop.filename)}
                      data-title={`Part ${part} Start ${prop.label}`}
                      data-path={prop.path}
                      data-part={part}
                      data-kind="start"
                      data-value={prop.path}
                      class="relative block w-full text-left"
                      title="Click to open full preview"
                    >
                      <div class="relative overflow-hidden rounded">
                        <img
                          src={animationFileUrl(film, name, prop.filename)}
                          alt={`Part ${part} start ${prop.label}`}
                          class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                          loading="lazy"
                        />
                        <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-teal-shadow backdrop-blur-sm">
                          🔍 Preview
                        </span>
                      </div>
                    </button>

                    <button
                      type="button"
                      data-delete-proposal
                      data-film={film}
                      data-name={name}
                      data-part={part}
                      data-kind="start"
                      data-filename={prop.filename}
                      title={`Delete ${prop.filename}`}
                      class="absolute top-1.5 right-1.5 z-10 flex h-6 w-6 items-center justify-center rounded bg-black/70 text-slate-300 backdrop-blur-sm transition-colors hover:bg-rose-900/80 hover:text-rose-200"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>

                  <div class="mt-2">
                    <span class="block truncate text-xs font-semibold text-slate-200">
                      Start {prop.label}
                    </span>
                    <span
                      class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                      title={prop.filename}
                    >
                      {prop.filename}
                    </span>
                  </div>
                  <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                    <button
                      type="button"
                      data-toggle-selection
                      class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                    >
                      Select frame
                    </button>
                    <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                      Selected
                    </span>
                  </div>
                </div>
              ))}

            {/* Option: Previous Scene Closing Frame (Part 0 only) */}
            {canUsePreviousSceneFrame && (
              <div
                data-tile-container
                data-value={previousFrame!}
                class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
              >
                <button
                  type="button"
                  data-preview-image
                  data-src={animationFileUrl(
                    film,
                    previousStory!.name,
                    `part-${previousPart}-end.jpg`
                  )}
                  data-title={`Previous Scene Closing Frame (${previousStory?.title})`}
                  data-path={previousFrame!}
                  data-part={part}
                  data-kind="start"
                  data-value={previousFrame!}
                  class="relative block w-full text-left"
                  title="Click to open full preview"
                >
                  <div class="relative overflow-hidden rounded">
                    <img
                      src={animationFileUrl(
                        film,
                        previousStory!.name,
                        `part-${previousPart}-end.jpg`
                      )}
                      alt="Previous scene closing frame"
                      class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-teal-shadow backdrop-blur-sm">
                      🔍 Preview
                    </span>
                  </div>
                </button>
                <div class="mt-2">
                  <span class="block truncate text-xs font-semibold text-slate-200">
                    Match Prev Scene
                  </span>
                  <span
                    class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                    title={previousFrame!}
                  >
                    {previousStory?.title || "Previous scene"}
                  </span>
                </div>
                <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                  <button
                    type="button"
                    data-toggle-selection
                    class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                  >
                    Select frame
                  </button>
                  <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                    Selected
                  </span>
                </div>
              </div>
            )}

            {/* Option: Prior Part End Frame (Part > 0) */}
            {priorSegment && priorSegment.endThumb && (
              <div
                data-tile-container
                data-value={`films/${film}/out/animations/${name}/${priorSegment.endThumb}`}
                class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
              >
                <button
                  type="button"
                  data-preview-image
                  data-src={animationFileUrl(film, name, priorSegment.endThumb)}
                  data-title={`Part ${part - 1} End Frame`}
                  data-path={`films/${film}/out/animations/${name}/${priorSegment.endThumb}`}
                  data-part={part}
                  data-kind="start"
                  data-value={`films/${film}/out/animations/${name}/${priorSegment.endThumb}`}
                  class="relative block w-full text-left"
                  title="Click to open full preview"
                >
                  <div class="relative overflow-hidden rounded">
                    <img
                      src={animationFileUrl(film, name, priorSegment.endThumb)}
                      alt="Prior part end frame"
                      class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-teal-shadow backdrop-blur-sm">
                      🔍 Preview
                    </span>
                  </div>
                </button>
                <div class="mt-2">
                  <span class="block truncate text-xs font-semibold text-slate-200">
                    Part {part - 1} End Frame
                  </span>
                  <span
                    class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                    title={priorSegment.endThumb}
                  >
                    {priorSegment.endThumb}
                  </span>
                </div>
                <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                  <button
                    type="button"
                    data-toggle-selection
                    class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                  >
                    Select frame
                  </button>
                  <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                    Selected
                  </span>
                </div>
              </div>
            )}
          </div>
        ) : (
          <p class="py-2 text-xs italic text-muted">
            No start frame overrides available. (Defaults to{" "}
            {index === 0
              ? "scene background plate"
              : `prior part ${part - 1} end frame`}
            ).
          </p>
        )
      }
    </div>

    <button
      type="button"
      data-trigger-keyframe="start"
      data-part={part}
      data-film={film}
      data-name={name}
      class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg border border-dashed border-line/80 py-2.5 text-xs font-medium text-muted transition-colors hover:border-amber-key/50 hover:bg-amber-key/5 hover:text-amber-soft"
    >
      <span class="text-amber-key">+</span>
      <span>Generate start frame proposal</span>
    </button>
  </div>

  {/* LAST FRAME CARD */}
  <div class="flex flex-col justify-between rounded-xl border border-line bg-ink/30 p-4">
    <div>
      <div class="mb-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-amber-key"></span>
          <h3 class="font-display text-sm font-semibold tracking-wide text-amber-soft">
            Add last frame
          </h3>
        </div>
        <span class="font-mono text-[10px] text-muted">
          --frame_end
        </span>
      </div>

      {
        hasEndOptions ? (
          <div
            class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            data-frame-selector="end"
            data-part={part}
          >
            {/* Option: End Proposals */}
            {hasEndProposal &&
              proposals.end.map((prop) => (
                <div
                  data-tile-container
                  data-value={prop.path}
                  class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
                >
                  <div class="relative">
                    <button
                      type="button"
                      data-preview-image
                      data-src={animationFileUrl(film, name, prop.filename)}
                      data-title={`Part ${part} End ${prop.label}`}
                      data-path={prop.path}
                      data-kind="end"
                      data-value={prop.path}
                      class="relative block w-full text-left"
                      title="Click to open full preview"
                    >
                      <div class="relative overflow-hidden rounded">
                        <img
                          src={animationFileUrl(film, name, prop.filename)}
                          alt={`Part ${part} end ${prop.label}`}
                          class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                          loading="lazy"
                        />
                        <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-amber-key backdrop-blur-sm">
                          🔍 Preview
                        </span>
                      </div>
                    </button>

                    <button
                      type="button"
                      data-delete-proposal
                      data-film={film}
                      data-name={name}
                      data-part={part}
                      data-kind="end"
                      data-filename={prop.filename}
                      title={`Delete ${prop.filename}`}
                      class="absolute top-1.5 right-1.5 z-10 flex h-6 w-6 items-center justify-center rounded bg-black/70 text-slate-300 backdrop-blur-sm transition-colors hover:bg-rose-900/80 hover:text-rose-200"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>

                  <div class="mt-2">
                    <span class="block truncate text-xs font-semibold text-slate-200">
                      End {prop.label}
                    </span>
                    <span
                      class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                      title={prop.filename}
                    >
                      {prop.filename}
                    </span>
                  </div>
                  <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                    <button
                      type="button"
                      data-toggle-selection
                      class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                    >
                      Select frame
                    </button>
                    <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                      Selected
                    </span>
                  </div>
                </div>
              ))}

            {/* Option: Next Scene Opening Frame (Last Part only) */}
            {canUseNextSceneFrame && (
              <div
                data-tile-container
                data-value={nextFrame!}
                class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
              >
                <button
                  type="button"
                  data-preview-image
                  data-src={animationFileUrl(
                    film,
                    nextStory!.name,
                    `part-${nextPart}-start.jpg`
                  )}
                  data-title={`Next Scene Opening Frame (${nextStory?.title})`}
                  data-path={nextFrame!}
                  data-part={part}
                  data-kind="end"
                  data-value={nextFrame!}
                  class="relative block w-full text-left"
                  title="Click to open full preview"
                >
                  <div class="relative overflow-hidden rounded">
                    <img
                      src={animationFileUrl(
                        film,
                        nextStory!.name,
                        `part-${nextPart}-start.jpg`
                      )}
                      alt="Next scene opening frame"
                      class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-amber-key backdrop-blur-sm">
                      🔍 Preview
                    </span>
                  </div>
                </button>
                <div class="mt-2">
                  <span class="block truncate text-xs font-semibold text-slate-200">
                    Match Next Scene
                  </span>
                  <span
                    class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                    title={nextFrame!}
                  >
                    {nextStory?.title || "Next scene"}
                  </span>
                </div>
                <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                  <button
                    type="button"
                    data-toggle-selection
                    class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                  >
                    Select frame
                  </button>
                  <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                    Selected
                  </span>
                </div>
              </div>
            )}

            {/* Option: Next Part Start Frame (Middle parts) */}
            {nextSegment && nextSegment.startThumb && (
              <div
                data-tile-container
                data-value={`films/${film}/out/animations/${name}/${nextSegment.startThumb}`}
                class="frame-choice-tile group relative flex flex-col justify-between overflow-hidden rounded-lg border border-line bg-panel/70 p-2.5 transition-all hover:border-slate-400"
              >
                <button
                  type="button"
                  data-preview-image
                  data-src={animationFileUrl(film, name, nextSegment.startThumb)}
                  data-title={`Part ${part + 1} Start Frame`}
                  data-path={`films/${film}/out/animations/${name}/${nextSegment.startThumb}`}
                  data-part={part}
                  data-kind="end"
                  data-value={`films/${film}/out/animations/${name}/${nextSegment.startThumb}`}
                  class="relative block w-full text-left"
                  title="Click to open full preview"
                >
                  <div class="relative overflow-hidden rounded">
                    <img
                      src={animationFileUrl(film, name, nextSegment.startThumb)}
                      alt="Next part start frame"
                      class="aspect-video w-full rounded border border-line object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[9px] text-amber-key backdrop-blur-sm">
                      🔍 Preview
                    </span>
                  </div>
                </button>
                <div class="mt-2">
                  <span class="block truncate text-xs font-semibold text-slate-200">
                    Part {part + 1} Start Frame
                  </span>
                  <span
                    class="mt-0.5 block truncate font-mono text-[10px] text-muted"
                    title={nextSegment.startThumb}
                  >
                    {nextSegment.startThumb}
                  </span>
                </div>
                <div class="mt-2.5 flex items-center justify-between border-t border-line/60 pt-2">
                  <button
                    type="button"
                    data-toggle-selection
                    class="rounded bg-ink/70 px-2.5 py-1 text-[10px] font-medium text-slate-300 ring-1 ring-line hover:bg-ink hover:text-emerald-300 transition-colors"
                  >
                    Select frame
                  </button>
                  <span class="selected-badge hidden rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-300 ring-1 ring-emerald-500/40">
                    Selected
                  </span>
                </div>
              </div>
            )}
          </div>
        ) : (
          <p class="py-2 text-xs italic text-muted">
            No last frame overrides available. (Defaults to natural ending
            pose).
          </p>
        )
      }
    </div>

    <button
      type="button"
      data-trigger-keyframe="end"
      data-part={part}
      data-film={film}
      data-name={name}
      class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-lg border border-dashed border-line/80 py-2.5 text-xs font-medium text-muted transition-colors hover:border-amber-key/50 hover:bg-amber-key/5 hover:text-amber-soft"
    >
      <span class="text-amber-key">+</span>
      <span>Generate end frame proposal</span>
    </button>
  </div>
</div>
