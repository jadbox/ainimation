---
import Layout from "../../layouts/Base.astro";
import {
  backgroundBlueprintDir,
  blueprintCommand,
  blueprintDir,
  blueprintInfo,
  loadMovie,
  slugify,
} from "../../lib/movie";

export const prerender = false;

const segments = (Astro.params.path ?? "")
  .split("/")
  .map((s) => s.trim())
  .filter(Boolean);

if (segments.length < 1 || segments.length > 2) {
  return Astro.redirect("/");
}

const movie = loadMovie();
const [name, name2] = segments;
const character = movie.characters.find((c) => slugify(c.name) === name);
const scene = movie.scenes.find((s) => slugify(s.slug) === name);

let view:
  | {
      kind: "subject";
      title: string;
      subtitle: string;
      dir: string;
      relDir: string;
      target: { character?: string; scene?: string };
      note?: string;
    }
  | { kind: "scene-picker" }
  | null = null;

if (name2) {
  const background = scene?.backgrounds.find((b) => slugify(b.key) === name2);
  if (!scene || !background) {
    return Astro.redirect("/");
  }
  view = {
    kind: "subject",
    title: `${scene.name} — ${background.key}`,
    subtitle: `scene background · ${scene.slug}/${background.key}`,
    dir: backgroundBlueprintDir(scene.slug, background.key),
    relDir: `${slugify(scene.slug)}/${slugify(background.key)}`,
    target: { scene: scene.slug },
    note: `Generating recreates all ${scene.backgrounds.length} background plate(s) for this scene.`,
  };
} else if (character) {
  view = {
    kind: "subject",
    title: character.name,
    subtitle: `character · ${slugify(character.name)}`,
    dir: blueprintDir(character.name),
    relDir: slugify(character.name),
    target: { character: character.name },
  };
} else if (scene && scene.backgrounds.length === 1) {
  return Astro.redirect(`/blueprint/${slugify(scene.slug)}/${slugify(scene.backgrounds[0].key)}`);
} else if (scene) {
  view = { kind: "scene-picker" };
} else {
  return Astro.redirect("/");
}

const info = view.kind === "subject" ? blueprintInfo(view.dir) : null;
const mainImage = info ? info.latest ?? info.style : null;
const thumbnails = info
  ? mainImage === info.latest
    ? info.attempts.slice(0, -1)
    : info.attempts
  : [];
const command = view.kind === "subject" ? blueprintCommand(view.target) : "";
---

<Layout title={view.kind === "subject" ? view.title : scene?.name ?? "Blueprint"}>
  <nav class="mb-4">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-muted ring-1 ring-line hover:text-amber-soft hover:ring-amber-key/40 transition-colors"
    >
      &larr; Back
    </a>
  </nav>

  {view.kind === "scene-picker" && scene && (
    <div class="rounded-xl border border-line bg-panel p-6 shadow-lg shadow-black/30">
      <h1 class="font-display text-2xl text-amber-soft">{scene.name}</h1>
      <p class="mt-1 font-mono text-sm text-muted">{scene.slug}</p>
      <p class="mt-4 text-sm text-slate-300">Pick a background plate:</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {scene.backgrounds.map((bg) => (
          <a
            href={`/blueprint/${slugify(scene.slug)}/${slugify(bg.key)}`}
            class="rounded-md bg-teal-shadow/10 px-3 py-1.5 text-sm text-teal-shadow ring-1 ring-teal-shadow/30 hover:bg-teal-shadow/20 transition-colors"
          >
            {bg.key}
          </a>
        ))}
      </div>
    </div>
  )}

  {view.kind === "subject" && (
    <div class="space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl text-amber-soft">{view.title}</h1>
          <p class="mt-1 font-mono text-sm text-muted">{view.subtitle}</p>
        </div>
        <div class="flex flex-col items-end gap-1.5">
          <button
            type="button"
            id="generate-btn"
            data-target={JSON.stringify(view.target)}
            title={command}
            class="rounded-md bg-amber-key/15 px-4 py-2 text-xs font-medium text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors"
          >
            {mainImage ? "Regenerate design" : "Generate design"}
          </button>
          {view.note && <span class="max-w-56 text-right text-[10px] text-muted">{view.note}</span>}
        </div>
      </div>

      {mainImage ? (
        <figure class="overflow-hidden rounded-xl border border-line bg-panel shadow-lg shadow-black/30">
          <img
            src={`/api/blueprint-image/${view.relDir}/${mainImage}`}
            alt={`${view.title} blueprint`}
            class="w-full"
          />
          <figcaption class="border-t border-line px-5 py-3 font-mono text-xs text-muted">
            out/blueprint/{view.relDir}/{mainImage}
          </figcaption>
        </figure>
      ) : (
        <div class="rounded-xl border border-dashed border-line bg-panel/50 px-6 py-16 text-center">
          <p class="text-sm text-muted">
            No blueprint generated yet. Run{" "}
            <code class="text-teal-shadow">{command}</code> or use the button above.
          </p>
        </div>
      )}

      {thumbnails.length > 0 && (
        <section>
          <h2 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">
            Previous attempts
          </h2>
          <div class="flex flex-wrap gap-2">
            {thumbnails.map((t) => (
              <a
                href={`/api/blueprint-image/${view.relDir}/${t}`}
                target="_blank"
                rel="noreferrer"
                class="block overflow-hidden rounded-md ring-1 ring-line hover:ring-amber-key/50 transition"
                title={`out/blueprint/${view.relDir}/${t}`}
              >
                <img
                  src={`/api/blueprint-image/${view.relDir}/${t}`}
                  alt={`${view.title} ${t}`}
                  class="h-20 w-auto"
                />
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
</Layout>

{view.kind === "subject" && (
  <>
    <div
      id="run-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Blueprint generation output"
  >
    <div class="flex max-h-[85vh] w-full max-w-3xl flex-col rounded-xl border border-line bg-panel shadow-2xl">
      <div class="flex items-center justify-between border-b border-line px-5 py-3">
        <h2 class="font-display text-amber-soft">
          Running <span id="run-title" class="font-mono text-sm text-teal-shadow"></span>
        </h2>
        <div class="flex items-center gap-2">
          <span id="run-state" class="text-xs text-muted">starting…</span>
          <button
            type="button"
            id="run-cancel"
            class="rounded-md px-3 py-1 text-xs text-rose-300 ring-1 ring-rose-400/40 hover:bg-rose-500/10 transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            id="run-close"
            class="hidden rounded-md bg-amber-key/15 px-3 py-1 text-xs text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors"
          >
            Close
          </button>
        </div>
      </div>
      <pre
        id="run-log"
        class="flex-1 overflow-auto whitespace-pre-wrap break-words bg-ink/80 px-5 py-4 font-mono text-xs leading-relaxed text-slate-300"
      ></pre>
    </div>
  </div>

  <script>
    const modal = document.getElementById("run-modal") as HTMLDivElement;
    const logEl = document.getElementById("run-log") as HTMLPreElement;
    const titleEl = document.getElementById("run-title") as HTMLSpanElement;
    const stateEl = document.getElementById("run-state") as HTMLSpanElement;
    const cancelBtn = document.getElementById("run-cancel") as HTMLButtonElement;
    const closeBtn = document.getElementById("run-close") as HTMLButtonElement;
    const generateBtn = document.getElementById("generate-btn") as HTMLButtonElement;
    let aborter: AbortController | null = null;

    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    async function runGenerate(target: { character?: string; scene?: string }) {
      const command = target.character
        ? `uv run generate-blueprint --character "${target.character}"`
        : `uv run generate-blueprint --scene ${target.scene}`;
      titleEl.textContent = command;
      logEl.textContent = "";
      stateEl.textContent = "starting…";
      cancelBtn.classList.remove("hidden");
      closeBtn.classList.add("hidden");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      aborter = new AbortController();
      let succeeded = false;
      try {
        const res = await fetch("/api/generate-blueprint", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(target),
          signal: aborter.signal,
        });
        if (!res.ok || !res.body) {
          const detail = await res.text().catch(() => "");
          logEl.textContent += `\n[http ${res.status}] ${detail}\n`;
          stateEl.textContent = "failed";
          return;
        }
        stateEl.textContent = "running…";
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          logEl.textContent += decoder.decode(value, { stream: true });
          logEl.scrollTop = logEl.scrollHeight;
          const exitMatch = logEl.textContent.match(/\[exit:(\d+)\]\s*$/);
          if (exitMatch) succeeded = exitMatch[1] === "0";
        }
        stateEl.textContent = succeeded ? "done" : "failed";
      } catch (err) {
        if ((err as Error).name === "AbortError") {
          stateEl.textContent = "cancelled";
        } else {
          logEl.textContent += `\n[error] ${(err as Error).message}\n`;
          stateEl.textContent = "failed";
        }
      } finally {
        cancelBtn.classList.add("hidden");
        closeBtn.classList.remove("hidden");
        if (succeeded) {
          setTimeout(() => location.reload(), 600);
        }
      }
    }

    generateBtn?.addEventListener("click", () => {
      try {
        const target = JSON.parse(generateBtn.dataset.target ?? "{}");
        void runGenerate(target);
      } catch {
        /* invalid target; ignore */
      }
    });

    cancelBtn.addEventListener("click", () => aborter?.abort());
    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (event) => {
      if (event.target === modal && !closeBtn.classList.contains("hidden")) closeModal();
    });
  </script>
  </>
)}
