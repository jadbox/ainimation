---
/**
 * Animation Console Page: /[film]/animate/[name]
 * 
 * Central directing console for generating, previewing, and selecting frames
 * and video clips for each segment of a scene.
 * 
 * Subcomponents:
 * - ReferenceDeck: Displays character and background blueprint attempts.
 * - SceneSegmentSection: Per-part card with video list, frame choice tiles, and script viewer.
 * - KeyframeModal: Interactive dialog for generating keyframe proposals in the CLI terminal.
 * - CLITerminal: Integrated floating terminal running live generation commands.
 */
import Layout from "../../../layouts/Base.astro";
import CLITerminal from "../../../components/CLITerminal.astro";
import ReferenceDeck from "../../../components/ReferenceDeck.astro";
import SceneSegmentSection from "../../../components/SceneSegmentSection.astro";
import KeyframeModal from "../../../components/KeyframeModal.astro";
import {
  backgroundBlueprintDir,
  blueprintImageUrl,
  blueprintInfo,
  isValidFilm,
  loadMovie,
  partProposals,
  readScript,
  resolveSceneFrame,
  sceneVideos,
  scriptPartIndices,
  slugify,
  subjectBlueprintDir,
} from "../../../lib/movie";

export const prerender = false;

const film = Astro.params.film ?? "";
const name = Astro.params.name ?? "";
if (!isValidFilm(film)) {
  return Astro.redirect("/");
}

const movie = loadMovie(film);
const storyIndex = movie.story.findIndex((scene) => scene.name === name);
if (storyIndex < 0) {
  return Astro.redirect(`/${film}`);
}

const story = movie.story[storyIndex];
const location = movie.scenes.find((scene) => scene.slug === story.scene);
const parts = scriptPartIndices(film, name);
const scripts = parts.map((part) => readScript(film, name, part));
const videos = sceneVideos(film, name);

const characterReferences = story.characters.map((character) => {
  const dir = subjectBlueprintDir(film, character);
  const image = blueprintInfo(dir).latest;
  return {
    character,
    href: `/${film}/blueprint/${slugify(character)}`,
    image: image ? blueprintImageUrl(film, slugify(character), image) : null,
    path: image
      ? `films/${film}/out/blueprint/${slugify(character)}/${image}`
      : null,
  };
});

const backgroundReferences = (location?.backgrounds ?? []).map((background) => {
  const dir = backgroundBlueprintDir(film, location!.slug, background.key);
  const image = blueprintInfo(dir).latest;
  const relativeDir = `${slugify(location!.slug)}/${slugify(background.key)}`;
  return {
    key: background.key,
    href: `/${film}/blueprint/${relativeDir}`,
    image: image ? blueprintImageUrl(film, relativeDir, image) : null,
    path: image ? `films/${film}/out/blueprint/${relativeDir}/${image}` : null,
  };
});

const previousStory = movie.story[storyIndex - 1];
const nextStory = movie.story[storyIndex + 1];
const previousPart = previousStory
  ? scriptPartIndices(film, previousStory.name).at(-1)
  : undefined;
const nextPart = nextStory
  ? scriptPartIndices(film, nextStory.name).at(0)
  : undefined;
const previousFrame =
  previousStory && previousPart !== undefined
    ? resolveSceneFrame(film, previousStory.name, previousPart, "end")
    : null;
const nextFrame =
  nextStory && nextPart !== undefined
    ? resolveSceneFrame(film, nextStory.name, nextPart, "start")
    : null;
---

<Layout film={film} title={`Animate ${story.title}`}>
  <div id="animate-scene-root" data-film={film} data-name={name}>
    <nav class="mb-4 text-sm text-muted">
      <a href={`/${film}`} class="hover:text-amber-soft transition-colors">
        &larr; All scenes
      </a>
      <span class="mx-2 text-line">/</span>
      <a
        href={`/${film}/scene/${name}`}
        class="hover:text-amber-soft transition-colors"
      >
        View scripts
      </a>
      {
        videos.full && (
          <>
            <span class="mx-2 text-line">/</span>
            <a
              href={`/${film}/video/${name}`}
              class="hover:text-amber-soft transition-colors"
            >
              Full scene video
            </a>
          </>
        )
      }
    </nav>

    {/* Scene Title & Description Header */}
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-teal-shadow">
          Generate scene
        </p>
        <h1 class="mt-1 font-display text-3xl text-amber-soft">{story.title}</h1>
        <p class="mt-1 font-mono text-sm text-muted">{name}</p>
      </div>
      <div class="flex flex-col items-start gap-3 sm:items-end">
        {
          videos.full && (
            <a
              href={`/${film}/video/${name}`}
              class="inline-flex items-center gap-2 rounded-lg bg-amber-key/15 px-3.5 py-2 text-xs font-semibold text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 hover:ring-amber-key/60 transition-all shadow-sm group"
            >
              <svg
                class="h-4 w-4 fill-current text-amber-key transition-transform group-hover:scale-110"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
              <span>View Full Scene</span>
            </a>
          )
        }
        <p class="max-w-sm text-sm leading-relaxed text-muted sm:text-right">
          Click on any image to open full preview. Select start/last frames for continuity locking, generate keyframe proposals, and run video generation.
        </p>
      </div>
    </div>

    {/* Reference Deck Component */}
    <ReferenceDeck
      characterReferences={characterReferences}
      backgroundReferences={backgroundReferences}
    />

    {/* Empty State Warning */}
    {
      parts.length === 0 && (
        <div class="mb-4 rounded-xl border border-line bg-panel px-5 py-6 text-center shadow-lg shadow-black/20">
          <p class="text-sm text-muted">
            No script parts found.{" "}
            <a
              href={`/${film}/scene/${name}`}
              class="font-medium text-amber-soft underline-offset-2 hover:underline"
            >
              Visit Script Page now.
            </a>
          </p>
        </div>
      )
    }

    {/* Scene Segment Sections */}
    <div class="space-y-6">
      {
        scripts.map((script, index) => {
          const part = parts[index];
          const segVideo = videos.segments.find((s) => s.part === part);
          const proposals = partProposals(film, name, part);
          const priorSegment = index > 0 ? videos.segments.find((s) => s.part === parts[index - 1]) ?? null : null;
          const nextSegment = index < parts.length - 1 ? videos.segments.find((s) => s.part === parts[index + 1]) ?? null : null;
          const priorProposals = index > 0 ? partProposals(film, name, parts[index - 1]) : null;
          const nextProposals = index < parts.length - 1 ? partProposals(film, name, parts[index + 1]) : null;

          return (
            <SceneSegmentSection
              film={film}
              name={name}
              part={part}
              index={index}
              partsCount={parts.length}
              script={script}
              segVideo={segVideo}
              proposals={proposals}
              previousFrame={previousFrame}
              previousStory={previousStory}
              previousPart={previousPart}
              nextFrame={nextFrame}
              nextStory={nextStory}
              nextPart={nextPart}
              priorSegment={priorSegment}
              nextSegment={nextSegment}
              priorProposals={priorProposals}
              nextProposals={nextProposals}
            />
          );
        })
      }
    </div>

    {/* Keyframe Proposal Modal */}
    <KeyframeModal />
  </div>

  {/* CLI Terminal Output Drawer */}
  <CLITerminal />
</Layout>

<script>
  import {
    initDeleteHandlers,
    initDurationSelectors,
    initFrameSelectors,
    initGeneratePartHandlers,
    initModelSelectors,
    initPartVideoSelectionHandlers,
  } from "../../../components/frame-selection";

  const rootEl = document.getElementById("animate-scene-root");
  const currentFilm =
    rootEl?.dataset.film ||
    document.querySelector<HTMLElement>("[data-film]")?.dataset.film ||
    "";
  const currentSceneName =
    rootEl?.dataset.name ||
    document.querySelector<HTMLElement>("[data-name]")?.dataset.name ||
    "";

  // Initialize frame selections, duration, and model from localStorage & attach all action handlers
  initFrameSelectors(currentFilm, currentSceneName);
  initDurationSelectors(currentFilm, currentSceneName);
  initModelSelectors(currentFilm, currentSceneName);
  initDeleteHandlers();
  initGeneratePartHandlers();
  initPartVideoSelectionHandlers();
</script>
