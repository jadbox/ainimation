---
import Layout from "../../../layouts/Base.astro";
import CommandMetadata from "../../../components/CommandMetadata.astro";
import { animationFileUrl, isValidFilm, loadMovie, readVideoMetadata, sceneVideos } from "../../../lib/movie";

export const prerender = false;

const film = Astro.params.film ?? "";
const slug = Astro.params.slug ?? "";
if (!isValidFilm(film)) {
  return Astro.redirect("/");
}

const partMatch = slug.match(/^(.+)_part_(\d+)(?:_v(\d+))?$/);
const sceneName = partMatch ? partMatch[1] : slug;
const part = partMatch ? Number(partMatch[2]) : null;
const reqVersion = partMatch && partMatch[3] !== undefined ? Number(partMatch[3]) : null;

const movie = loadMovie(film);
const story = movie.story.find((s) => s.name === sceneName);
if (!story) {
  return Astro.redirect(`/${film}`);
}

const videos = sceneVideos(film, sceneName);
const seg = part !== null ? videos.segments.find((s) => s.part === part) : null;
const versionItem = seg
  ? reqVersion !== null
    ? seg.versions.find((v) => v.version === reqVersion) ?? seg.versions[seg.versions.length - 1]
    : seg.versions[seg.versions.length - 1]
  : null;

const current =
  part === null
    ? videos.full && { file: "full.mp4", thumb: videos.full.thumb, label: "Full scene" }
    : versionItem && {
        file: versionItem.filename,
        thumb: versionItem.thumb,
        label: `Part ${part} ${versionItem.label}`,
      };

if (!current) {
  return Astro.redirect(`/${film}`);
}

const videoUrl = animationFileUrl(film, sceneName, current.file);
const posterUrl = current.thumb ? animationFileUrl(film, sceneName, current.thumb) : undefined;
const metadata = readVideoMetadata(film, sceneName, current.file);

const related: { href: string; label: string; thumb: string | null; active: boolean }[] = [];
if (videos.full) {
  related.push({
    href: `/${film}/video/${sceneName}`,
    label: "Full Scene",
    thumb: videos.full.thumb,
    active: part === null,
  });
}
for (const s of videos.segments) {
  for (const v of s.versions) {
    const isThisActive =
      part === s.part &&
      (reqVersion !== null
        ? v.version === reqVersion
        : v.version === s.versions[s.versions.length - 1].version);
    related.push({
      href: `/${film}/video/${sceneName}_part_${s.part}${v.version > 0 ? `_v${v.version}` : ""}`,
      label: `Part ${s.part} ${v.label}`,
      thumb: v.thumb,
      active: isThisActive,
    });
  }
}
---

<Layout film={film} title={`${story.title} · ${current.label}`}>
  <nav class="mb-4">
    <a
      href={`/${film}`}
      class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-muted ring-1 ring-line hover:text-amber-soft hover:ring-amber-key/40 transition-colors"
    >
      &larr; Back
    </a>
  </nav>

  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl text-amber-soft">{story.title}</h1>
      <p class="mt-1 font-mono text-sm text-muted">
        {sceneName} · {current.label.toLowerCase()} · films/{film}/out/animations/{sceneName}/{current.file}
      </p>
    </div>
    {part !== null && (
      <button
        type="button"
        id="delete-video-btn"
        data-film={film}
        data-name={sceneName}
        data-part={part}
        data-filename={current.file}
        class="inline-flex items-center gap-1.5 rounded-md bg-rose-600/15 px-3 py-1.5 text-xs font-semibold text-rose-300 ring-1 ring-rose-500/40 hover:bg-rose-600/25 transition-colors cursor-pointer"
        title={`Delete ${current.file}`}
      >
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete video
      </button>
    )}
  </div>

  <figure class="overflow-hidden rounded-xl border border-line bg-panel shadow-lg shadow-black/30">
    <video controls class="w-full max-h-[1366px] object-contain" src={videoUrl} poster={posterUrl}></video>
  </figure>

  {/* Reusable Collapsible CLI Command & Execution Logs Inspector */}
  <CommandMetadata metadata={metadata} title="CLI Command" />

  {related.length > 1 && (
    <section class="mt-6">
      <h2 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">All videos</h2>
      <div class="flex flex-wrap gap-3">
        {related.map((r) => (
          <a
            href={r.href}
            class:list={[
              "group block w-40 overflow-hidden rounded-lg ring-1 transition",
              r.active
                ? "ring-amber-key/60"
                : "ring-line hover:ring-amber-key/40",
            ]}
            title={r.label}
          >
            {r.thumb ? (
              <img
                src={animationFileUrl(film, sceneName, r.thumb)}
                alt={`${story.title} ${r.label}`}
                class="aspect-video w-full object-cover"
              />
            ) : (
              <div class="flex aspect-video w-full items-center justify-center bg-ink/60 text-xs text-muted">
                no thumb
              </div>
            )}
            <span
              class:list={[
                "block px-2 py-1 text-[10px] uppercase tracking-wide",
                r.active ? "bg-amber-key/15 text-amber-soft" : "bg-panel-2 text-muted group-hover:text-amber-soft",
              ]}
            >
              {r.label}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  import { confirmModal } from "../../../components/confirm-modal";

  const deleteBtn = document.getElementById("delete-video-btn") as HTMLButtonElement | null;
  deleteBtn?.addEventListener("click", async () => {
    const film = deleteBtn.dataset.film!;
    const name = deleteBtn.dataset.name!;
    const part = Number(deleteBtn.dataset.part);
    const filename = deleteBtn.dataset.filename!;

    const confirmed = await confirmModal({
      title: "Delete Generated Video",
      message: `Are you sure you want to delete "${filename}"?`,
      details: "This will delete the video file along with its generated start/end frame thumbnails, metadata file, and prompt file.",
      confirmLabel: "Delete Video",
      variant: "danger",
    });
    if (!confirmed) return;

    try {
      const res = await fetch("/api/delete-video", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ film, name, part, filename }),
      });
      if (res.ok) {
        location.href = `/${film}/animate/${name}`;
      } else {
        const err = await res.json().catch(() => ({}));
        alert(`Failed to delete video: ${err.error || res.statusText}`);
      }
    } catch (err) {
      alert(`Failed to delete video: ${(err as Error).message}`);
    }
  });
</script>
