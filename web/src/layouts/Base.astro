---
import "../styles/global.css";
import { loadMovie } from "../lib/movie";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · Animation Console` : "Animation Console";
const movie = loadMovie();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>
  <body class="text-slate-200 antialiased">
    <header class="border-b border-line/80 bg-panel/60 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-amber-key/15 text-amber-key text-lg font-bold ring-1 ring-amber-key/40"
            aria-hidden="true">N</span
          >
          <span class="leading-tight">
            <span class="block font-display text-lg text-amber-soft group-hover:text-amber-key transition-colors"
              >{movie.movie.title}</span
            >
            <span class="block text-xs uppercase tracking-widest text-muted">Animation Console</span>
          </span>
        </a>
        <nav class="text-sm text-muted flex items-center gap-4">
          <a href="/" class="hover:text-amber-soft transition-colors">Scenes</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-6 pb-10 pt-4 text-xs text-muted/80">
      Don Bluth style pipeline · scriptgen → blueprint → animator
    </footer>
  </body>
</html>
