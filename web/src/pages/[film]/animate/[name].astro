---
import Layout from "../../../layouts/Base.astro";
import CLITerminal from "../../../components/CLITerminal.astro";
import PartFrameSelectors from "../../../components/PartFrameSelectors.astro";
import {
  animationFileUrl,
  backgroundBlueprintDir,
  blueprintImageUrl,
  blueprintInfo,
  isValidFilm,
  loadMovie,
  partProposals,
  readScript,
  resolveSceneFrame,
  sceneVideos,
  scriptPartIndices,
  slugify,
  subjectBlueprintDir,
} from "../../../lib/movie";

export const prerender = false;

const film = Astro.params.film ?? "";
const name = Astro.params.name ?? "";
if (!isValidFilm(film)) {
  return Astro.redirect("/");
}

const movie = loadMovie(film);
const storyIndex = movie.story.findIndex((scene) => scene.name === name);
if (storyIndex < 0) {
  return Astro.redirect(`/${film}`);
}

const story = movie.story[storyIndex];
const location = movie.scenes.find((scene) => scene.slug === story.scene);
const parts = scriptPartIndices(film, name);
const scripts = parts.map((part) => readScript(film, name, part));
const videos = sceneVideos(film, name);
const timeRange = (part: number) =>
  `${Math.floor((part * 10) / 60)}:${String((part * 10) % 60).padStart(2, "0")}-${Math.floor(((part + 1) * 10) / 60)}:${String(((part + 1) * 10) % 60).padStart(2, "0")}`;

const characterReferences = story.characters.map((character) => {
  const dir = subjectBlueprintDir(film, character);
  const image = blueprintInfo(dir).latest;
  return {
    character,
    href: `/${film}/blueprint/${slugify(character)}`,
    image: image ? blueprintImageUrl(film, slugify(character), image) : null,
    path: image
      ? `films/${film}/out/blueprint/${slugify(character)}/${image}`
      : null,
  };
});

const backgroundReferences = (location?.backgrounds ?? []).map((background) => {
  const dir = backgroundBlueprintDir(film, location!.slug, background.key);
  const image = blueprintInfo(dir).latest;
  const relativeDir = `${slugify(location!.slug)}/${slugify(background.key)}`;
  return {
    key: background.key,
    href: `/${film}/blueprint/${relativeDir}`,
    image: image ? blueprintImageUrl(film, relativeDir, image) : null,
    path: image ? `films/${film}/out/blueprint/${relativeDir}/${image}` : null,
  };
});

const previousStory = movie.story[storyIndex - 1];
const nextStory = movie.story[storyIndex + 1];
const previousPart = previousStory
  ? scriptPartIndices(film, previousStory.name).at(-1)
  : undefined;
const nextPart = nextStory
  ? scriptPartIndices(film, nextStory.name).at(0)
  : undefined;
const previousFrame =
  previousStory && previousPart !== undefined
    ? resolveSceneFrame(film, previousStory.name, previousPart, "end")
    : null;
const nextFrame =
  nextStory && nextPart !== undefined
    ? resolveSceneFrame(film, nextStory.name, nextPart, "start")
    : null;
---

<Layout film={film} title={`Animate ${story.title}`}>
  <nav class="mb-4 text-sm text-muted">
    <a href={`/${film}`} class="hover:text-amber-soft transition-colors"
      >&larr; All scenes</a
    >
    <span class="mx-2 text-line">/</span>
    <a
      href={`/${film}/scene/${name}`}
      class="hover:text-amber-soft transition-colors">View scripts</a
    >
  </nav>

  <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-teal-shadow">
        Generate scene
      </p>
      <h1 class="mt-1 font-display text-3xl text-amber-soft">{story.title}</h1>
      <p class="mt-1 font-mono text-sm text-muted">{name}</p>
    </div>
    <p class="max-w-sm text-sm leading-relaxed text-muted">
      Click on any image to open full preview. Select start/last frames for continuity locking, generate keyframe proposals, and run video generation.
    </p>
  </div>

  <section
    class="mb-7 rounded-xl border border-line bg-panel/80 p-5 shadow-lg shadow-black/20"
  >
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="font-display text-xl text-amber-soft">Reference deck</h2>
      <span class="font-mono text-xs text-muted"
        >latest blueprint attempts used by animator & keyframes</span
      >
    </div>
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <h3
          class="mb-2 text-xs font-medium uppercase tracking-wider text-muted"
        >
          Characters
        </h3>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {
            characterReferences.map((reference) => (
              <div class="group relative overflow-hidden rounded-lg border border-line bg-ink/40 transition-colors hover:border-amber-key/50">
                {reference.image ? (
                  <button
                    type="button"
                    data-preview-image
                    data-src={reference.image}
                    data-title={`${reference.character} Blueprint`}
                    data-path={reference.path ?? ""}
                    class="block w-full text-left"
                    title={`Click to preview ${reference.character} full image`}
                  >
                    <img
                      src={reference.image}
                      alt={`${reference.character} reference`}
                      class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div class="flex aspect-video items-center justify-center px-3 text-center text-xs text-muted">
                    No reference image
                  </div>
                )}
                <figcaption class="flex items-center justify-between border-t border-line px-2.5 py-2">
                  <a
                    href={reference.href}
                    title={`Open ${reference.character} blueprint page`}
                    class="truncate text-xs text-slate-200 hover:text-amber-soft hover:underline"
                  >
                    {reference.character}
                  </a>
                  {reference.path && (
                    <span
                      class="shrink-0 font-mono text-[10px] text-muted"
                      title={reference.path}
                    >
                      ready
                    </span>
                  )}
                </figcaption>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h3
          class="mb-2 text-xs font-medium uppercase tracking-wider text-muted"
        >
          Backgrounds
        </h3>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {
            backgroundReferences.length > 0 ? (
              backgroundReferences.map((reference) => (
                <div class="group relative overflow-hidden rounded-lg border border-line bg-ink/40 transition-colors hover:border-amber-key/50">
                  {reference.image ? (
                    <button
                      type="button"
                      data-preview-image
                      data-src={reference.image}
                      data-title={`${reference.key} Background Plate`}
                      data-path={reference.path ?? ""}
                      class="block w-full text-left"
                      title={`Click to preview ${reference.key} full image`}
                    >
                      <img
                        src={reference.image}
                        alt={`${reference.key} background reference`}
                        class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
                        loading="lazy"
                      />
                    </button>
                  ) : (
                    <div class="flex aspect-video items-center justify-center px-3 text-center text-xs text-muted">
                      No background image
                    </div>
                  )}
                  <figcaption class="flex items-center justify-between border-t border-line px-2.5 py-2">
                    <a
                      href={reference.href}
                      title={`Open ${reference.key} blueprint page`}
                      class="truncate text-xs text-slate-200 hover:text-amber-soft hover:underline"
                    >
                      {reference.key}
                    </a>
                    {reference.path && (
                      <span
                        class="shrink-0 font-mono text-[10px] text-muted"
                        title={reference.path}
                      >
                        ready
                      </span>
                    )}
                  </figcaption>
                </div>
              ))
            ) : (
              <p class="col-span-full rounded-lg border border-dashed border-line px-3 py-5 text-sm text-muted">
                No configured background references.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    parts.length === 0 && (
      <div class="mb-4 rounded-xl border border-line bg-panel px-5 py-6 text-center shadow-lg shadow-black/20">
        <p class="text-sm text-muted">
          No script parts found.{" "}
          <a
            href={`/${film}/scene/${name}`}
            class="font-medium text-amber-soft underline-offset-2 hover:underline"
          >
            Visit Script Page now.
          </a>
        </p>
      </div>
    )
  }

  <div class="space-y-6">
    {
      scripts.map((script, index) => {
        const part = parts[index];
        const segVideo = videos.segments.find((s) => s.part === part);
        const proposals = partProposals(film, name, part);
        const hasStartProposal = proposals.start !== null;
        const hasEndProposal = proposals.end !== null;
        const canUsePreviousSceneFrame = index === 0 && previousFrame;
        const canUseNextSceneFrame = index === parts.length - 1 && nextFrame;
        const priorSegment = index > 0 ? videos.segments.find((s) => s.part === parts[index - 1]) : null;
        const nextSegment = index < parts.length - 1 ? videos.segments.find((s) => s.part === parts[index + 1]) : null;

        return (
          <section class="rounded-xl border border-line bg-panel shadow-lg shadow-black/20">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
              <div>
                <h2 class="font-display text-xl text-amber-soft">
                  Part {part}
                </h2>
                <p class="mt-0.5 text-xs text-muted">
                  {timeRange(part)} ·{" "}
                  <code>
                    scripts/{name}_part{part}.md
                  </code>
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  data-open-keyframe-modal
                  data-part={part}
                  data-film={film}
                  data-name={name}
                  class="rounded-md bg-amber-key/10 px-3 py-2 text-xs font-medium text-amber-soft ring-1 ring-amber-key/30 transition-colors hover:bg-amber-key/20"
                >
                  Keyframe proposal
                </button>
                {script ? (
                  <button
                    type="button"
                    data-generate-part
                    data-film={film}
                    data-name={name}
                    data-part={part}
                    class="rounded-md bg-teal-shadow/10 px-3.5 py-2 text-xs font-mono font-semibold text-teal-shadow ring-1 ring-teal-shadow/30 transition-colors hover:bg-teal-shadow/20"
                  >
                    GENERATE
                  </button>
                ) : (
                  <span class="rounded-full bg-amber-key/10 px-2.5 py-1 text-xs text-amber-soft ring-1 ring-amber-key/30">
                    script missing
                  </span>
                )}
              </div>
            </header>

            <div class="space-y-5 px-5 py-5">
              {segVideo && (
                <div>
                  <h3 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">
                    Rendered Video & Extracted Frames
                  </h3>
                  <div class="flex flex-wrap items-end gap-3">
                    {segVideo.startThumb && (
                      <button
                        type="button"
                        data-preview-image
                        data-src={animationFileUrl(film, name, segVideo.startThumb)}
                        data-title={`Part ${part} Video Start Frame`}
                        data-path={`films/${film}/out/animations/${name}/${segVideo.startThumb}`}
                        title={`Click to preview Part ${part} start frame`}
                        class="group block w-36 overflow-hidden rounded-lg border border-line bg-ink/40 text-left transition-colors hover:border-amber-key/50"
                      >
                        <img
                          src={animationFileUrl(film, name, segVideo.startThumb)}
                          alt={`Part ${part} start frame`}
                          class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
                          loading="lazy"
                        />
                        <span class="block border-t border-line px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-wide text-muted">
                          video start 🔍
                        </span>
                      </button>
                    )}
                    <a
                      href={`/${film}/video/${name}_part_${part}`}
                      title={`View Part ${part} video`}
                      class="group block w-[280px] overflow-hidden rounded-lg border border-line bg-ink/40 transition-colors hover:border-amber-key/50"
                    >
                      {segVideo.thumb ? (
                        <img
                          src={animationFileUrl(film, name, segVideo.thumb)}
                          alt={`Part ${part} video thumbnail`}
                          class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex aspect-video items-center justify-center px-3 text-center text-xs text-muted">
                          Part {part} video generated
                        </div>
                      )}
                      <figcaption class="border-t border-line px-2.5 py-2">
                        <span class="block truncate text-xs text-slate-200">
                          Part {part} video
                        </span>
                        <span class="mt-0.5 block truncate font-mono text-[10px] text-muted">
                          {name}_part_{part}.mp4
                        </span>
                      </figcaption>
                    </a>
                    {segVideo.endThumb && (
                      <button
                        type="button"
                        data-preview-image
                        data-src={animationFileUrl(film, name, segVideo.endThumb)}
                        data-title={`Part ${part} Video End Frame`}
                        data-path={`films/${film}/out/animations/${name}/${segVideo.endThumb}`}
                        title={`Click to preview Part ${part} end frame`}
                        class="group block w-36 overflow-hidden rounded-lg border border-line bg-ink/40 text-left transition-colors hover:border-amber-key/50"
                      >
                        <img
                          src={animationFileUrl(film, name, segVideo.endThumb)}
                          alt={`Part ${part} end frame`}
                          class="aspect-video w-full object-cover transition-transform group-hover:scale-105"
                          loading="lazy"
                        />
                        <span class="block border-t border-line px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-wide text-muted">
                          video end 🔍
                        </span>
                      </button>
                    )}
                  </div>
                </div>
              )}

              {/* Modular Start and Last Frame Selectors Component */}
              <PartFrameSelectors
                film={film}
                name={name}
                part={part}
                index={index}
                partsCount={parts.length}
                proposals={proposals}
                hasStartProposal={hasStartProposal}
                hasEndProposal={hasEndProposal}
                canUsePreviousSceneFrame={!!canUsePreviousSceneFrame}
                canUseNextSceneFrame={!!canUseNextSceneFrame}
                previousFrame={previousFrame}
                previousStory={previousStory}
                previousPart={previousPart}
                nextFrame={nextFrame}
                nextStory={nextStory}
                nextPart={nextPart}
                priorSegment={priorSegment}
                nextSegment={nextSegment}
              />

              {/* Collapsible script viewer */}
              <details class="group rounded-lg border border-line bg-ink/25">
                <summary class="cursor-pointer px-3.5 py-2.5 text-sm text-slate-300 marker:text-amber-key">
                  View part script
                </summary>
                {script ? (
                  <pre class="max-h-[34rem] overflow-auto border-t border-line p-4 font-mono text-xs leading-relaxed text-slate-300 whitespace-pre-wrap">
                    {script}
                  </pre>
                ) : (
                  <p class="border-t border-line p-4 text-sm italic text-muted">
                    Generate this scene's scripts before animating.
                  </p>
                )}
              </details>
            </div>
          </section>
        );
      })
    }
  </div>

  {/* FULL POPUP PANEL IMAGE PREVIEW MODAL */}
  <div
    id="image-preview-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 backdrop-blur-md transition-opacity"
    role="dialog"
    aria-modal="true"
    aria-label="Image Preview"
  >
    <div class="flex max-h-[95vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-line bg-panel shadow-2xl">
      <div class="flex items-center justify-between border-b border-line bg-ink/75 px-5 py-3.5">
        <div class="min-w-0 flex-1 pr-4">
          <h3 id="preview-modal-title" class="truncate font-display text-lg text-amber-soft">
            Frame Preview
          </h3>
          <p id="preview-modal-path" class="truncate font-mono text-xs text-muted" title="">
            path/to/image.jpg
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            id="preview-modal-open-tab"
            href="#"
            target="_blank"
            rel="noreferrer"
            class="rounded px-2.5 py-1 text-xs text-muted ring-1 ring-line hover:text-slate-200 transition-colors"
            title="Open original image in new tab"
          >
            Open raw ↗
          </a>
          <button
            type="button"
            id="preview-modal-close-x"
            class="rounded p-1 text-muted hover:text-slate-200 transition-colors"
            aria-label="Close"
          >
            &times;
          </button>
        </div>
      </div>

      <div class="flex flex-1 items-center justify-center overflow-auto bg-black/60 p-4 sm:p-6">
        <img
          id="preview-modal-img"
          src=""
          alt="Full frame preview"
          class="max-h-[72vh] w-auto max-w-full rounded-lg border border-line/60 object-contain shadow-2xl"
        />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-ink/60 px-5 py-3.5">
        <span id="preview-modal-status" class="font-mono text-xs text-muted">
          Click below to select this frame for video generation
        </span>
        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="preview-modal-delete-btn"
            class="hidden rounded-md bg-rose-600/20 px-3.5 py-1.5 text-xs font-semibold text-rose-300 ring-1 ring-rose-500/50 hover:bg-rose-600/30 transition-colors"
          >
            Delete proposal
          </button>
          <button
            type="button"
            id="preview-modal-close-btn"
            class="rounded-md px-3.5 py-1.5 text-xs text-muted ring-1 ring-line hover:text-slate-200 transition-colors"
          >
            Close
          </button>
          <button
            type="button"
            id="preview-modal-use-btn"
            class="hidden rounded-md bg-emerald-600/20 px-4 py-1.5 text-xs font-semibold text-emerald-300 ring-1 ring-emerald-500/50 hover:bg-emerald-600/30 transition-colors"
          >
            Use this frame
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* KEYFRAME PROPOSAL POPUP MODAL */}
  <div
    id="keyframe-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Generate Keyframe Proposal"
  >
    <div class="flex max-h-[90vh] w-full max-w-lg flex-col overflow-hidden rounded-xl border border-line bg-panel shadow-2xl">
      <div class="flex items-center justify-between border-b border-line bg-ink/70 px-5 py-3.5">
        <div>
          <h3 id="keyframe-modal-title" class="font-display text-lg text-amber-soft">
            Generate Keyframe Proposal
          </h3>
          <p id="keyframe-modal-subtitle" class="font-mono text-xs text-muted">
            Part 0
          </p>
        </div>
        <button
          type="button"
          id="keyframe-modal-close-x"
          class="rounded p-1 text-muted hover:text-slate-200 transition-colors"
        >
          &times;
        </button>
      </div>

      <div class="space-y-4 overflow-y-auto px-5 py-4 text-sm">
        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase tracking-wider text-muted">
            Proposal Target
          </label>
          <div class="grid grid-cols-3 gap-2">
            <label class="flex cursor-pointer flex-col items-center justify-center rounded-lg border border-line bg-ink/40 p-3 text-center transition-all hover:border-amber-key/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500/40">
              <input type="radio" name="keyframe-modal-target" value="start" checked class="sr-only" />
              <span class="text-xs font-semibold text-slate-200">Start Frame</span>
              <span class="mt-0.5 text-[10px] text-muted">0:00 Mark</span>
            </label>
            <label class="flex cursor-pointer flex-col items-center justify-center rounded-lg border border-line bg-ink/40 p-3 text-center transition-all hover:border-amber-key/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500/40">
              <input type="radio" name="keyframe-modal-target" value="end" class="sr-only" />
              <span class="text-xs font-semibold text-slate-200">Last Frame</span>
              <span class="mt-0.5 text-[10px] text-muted">Final Pose</span>
            </label>
            <label class="flex cursor-pointer flex-col items-center justify-center rounded-lg border border-line bg-ink/40 p-3 text-center transition-all hover:border-amber-key/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500/40">
              <input type="radio" name="keyframe-modal-target" value="both" class="sr-only" />
              <span class="text-xs font-semibold text-slate-200">Both</span>
              <span class="mt-0.5 text-[10px] text-muted">Start & End</span>
            </label>
          </div>
        </div>

        <div>
          <label class="mb-1.5 block text-xs font-medium uppercase tracking-wider text-muted">
            Continuity Reference (--ref)
          </label>
          <select
            id="keyframe-modal-ref-select"
            class="w-full rounded-lg border border-line bg-ink/60 px-3 py-2 text-xs text-slate-200 focus:border-amber-key focus:outline-none"
          >
            <option value="">Auto Discovery / None</option>
          </select>
          <input
            type="text"
            id="keyframe-modal-custom-ref"
            placeholder="Or enter custom image filename / path..."
            class="mt-2 w-full rounded-lg border border-line bg-ink/60 px-3 py-2 font-mono text-xs text-slate-200 placeholder:text-muted/60 focus:border-amber-key focus:outline-none"
          />
        </div>

        <label class="flex cursor-pointer items-center gap-2 text-xs text-muted hover:text-slate-200">
          <input type="checkbox" id="keyframe-modal-force" class="rounded accent-amber-key" />
          <span>Force overwrite existing proposal files (--force)</span>
        </label>

        <div class="rounded-lg border border-line bg-ink/70 p-3">
          <span class="block font-mono text-[11px] text-teal-shadow break-all" id="keyframe-modal-cmd-preview">
            uv run keyframes --film ...
          </span>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 border-t border-line bg-ink/40 px-5 py-3">
        <button
          type="button"
          id="keyframe-modal-cancel"
          class="rounded-md px-3 py-1.5 text-xs text-muted ring-1 ring-line hover:text-slate-200 transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="keyframe-modal-submit"
          class="rounded-md bg-amber-key/20 px-3.5 py-1.5 text-xs font-medium text-amber-soft ring-1 ring-amber-key/50 hover:bg-amber-key/30 transition-colors"
        >
          Generate Proposal in Terminal
        </button>
      </div>
    </div>
  </div>

  <CLITerminal />
</Layout>

<script>
  import { openCLITerminal } from "../../../components/cli-terminal";

  const currentFilm = document.querySelector<HTMLElement>("[data-film]")?.dataset.film ?? "";
  const currentSceneName = document.querySelector<HTMLElement>("[data-name]")?.dataset.name ?? "";

  // State maps per part: part -> { frameStart: string, frameEnd: string }
  const partFrameState = new Map<number, { frameStart: string; frameEnd: string }>();

  function toggleTileSelection(container: HTMLElement, part: number, kind: "start" | "end", value: string): boolean {
    const parentSelector = container.closest<HTMLElement>("[data-frame-selector]");
    if (!parentSelector) return false;

    const allTiles = parentSelector.querySelectorAll<HTMLElement>("[data-tile-container]");
    const isSelected = container.classList.contains("selected");
    const state = partFrameState.get(part)!;

    // Deselect all
    allTiles.forEach((t) => {
      t.classList.remove(
        "selected",
        "border-2",
        "border-emerald-500",
        "bg-emerald-950/20",
        "ring-2",
        "ring-emerald-500/40",
        "text-emerald-300"
      );
      t.classList.add("border", "border-line", "bg-panel/70");
      const badge = t.querySelector(".selected-badge");
      if (badge) badge.classList.add("hidden");
      const btn = t.querySelector<HTMLButtonElement>("[data-toggle-selection]");
      if (btn) btn.textContent = "Select frame";
    });

    if (isSelected) {
      if (kind === "start") state.frameStart = "";
      else state.frameEnd = "";
      return false;
    } else {
      container.classList.add(
        "selected",
        "border-2",
        "border-emerald-500",
        "bg-emerald-950/20",
        "ring-2",
        "ring-emerald-500/40",
        "text-emerald-300"
      );
      container.classList.remove("border-line", "bg-panel/70");
      const badge = container.querySelector(".selected-badge");
      if (badge) badge.classList.remove("hidden");
      const btn = container.querySelector<HTMLButtonElement>("[data-toggle-selection]");
      if (btn) btn.textContent = "Deselect";

      if (kind === "start") state.frameStart = value;
      else state.frameEnd = value;
      return true;
    }
  }

  // Initialize frame selectors & toggle buttons
  document.querySelectorAll<HTMLElement>("[data-frame-selector]").forEach((selectorContainer) => {
    const part = Number(selectorContainer.dataset.part);
    const kind = selectorContainer.dataset.frameSelector as "start" | "end";

    if (!partFrameState.has(part)) {
      partFrameState.set(part, { frameStart: "", frameEnd: "" });
    }

    const tiles = selectorContainer.querySelectorAll<HTMLElement>("[data-tile-container]");
    tiles.forEach((tile) => {
      const toggleBtn = tile.querySelector<HTMLButtonElement>("[data-toggle-selection]");
      toggleBtn?.addEventListener("click", () => {
        const val = tile.dataset.value ?? "";
        toggleTileSelection(tile, part, kind, val);
      });
    });
  });

  // Image preview modal elements
  const previewModal = document.getElementById("image-preview-modal") as HTMLDivElement | null;
  const previewImg = document.getElementById("preview-modal-img") as HTMLImageElement | null;
  const previewTitle = document.getElementById("preview-modal-title");
  const previewPath = document.getElementById("preview-modal-path");
  const previewOpenTab = document.getElementById("preview-modal-open-tab") as HTMLAnchorElement | null;
  const previewCloseX = document.getElementById("preview-modal-close-x");
  const previewCloseBtn = document.getElementById("preview-modal-close-btn");
  const previewUseBtn = document.getElementById("preview-modal-use-btn") as HTMLButtonElement | null;
  const previewDeleteBtn = document.getElementById("preview-modal-delete-btn") as HTMLButtonElement | null;
  const previewStatus = document.getElementById("preview-modal-status");

  let activePreviewTarget: {
    part?: number;
    kind?: "start" | "end";
    value?: string;
    tileElement?: HTMLElement | null;
    isProposal?: boolean;
  } | null = null;

  function openImagePreview(
    src: string,
    title: string,
    path: string,
    part?: number,
    kind?: "start" | "end",
    value?: string,
    tileElement?: HTMLElement | null,
    isProposal = false
  ): void {
    if (!previewModal || !previewImg) return;

    previewImg.src = src;
    if (previewTitle) previewTitle.textContent = title;
    if (previewPath) {
      previewPath.textContent = path;
      previewPath.title = path;
    }
    if (previewOpenTab) previewOpenTab.href = src;

    activePreviewTarget = { part, kind, value, tileElement, isProposal };

    if (part !== undefined && kind && value && tileElement) {
      const state = partFrameState.get(part);
      const isSelected = (kind === "start" ? state?.frameStart : state?.frameEnd) === value;

      if (previewUseBtn) {
        previewUseBtn.classList.remove("hidden");
        if (isSelected) {
          previewUseBtn.textContent = "✓ Frame Selected (Click to Deselect)";
          previewUseBtn.classList.remove("bg-emerald-600/20", "text-emerald-300", "ring-emerald-500/50");
          previewUseBtn.classList.add("bg-rose-600/20", "text-rose-300", "ring-rose-500/50");
        } else {
          previewUseBtn.textContent = `Select for ${kind === "start" ? "Start" : "Last"} Frame`;
          previewUseBtn.classList.add("bg-emerald-600/20", "text-emerald-300", "ring-emerald-500/50");
          previewUseBtn.classList.remove("bg-rose-600/20", "text-rose-300", "ring-rose-500/50");
        }
      }
      if (previewDeleteBtn) {
        if (isProposal) previewDeleteBtn.classList.remove("hidden");
        else previewDeleteBtn.classList.add("hidden");
      }
      if (previewStatus) {
        previewStatus.textContent = isSelected
          ? `Currently active for Part ${part} ${kind} continuity`
          : `Click below to select as Part ${part} ${kind} frame`;
      }
    } else {
      if (previewUseBtn) previewUseBtn.classList.add("hidden");
      if (previewDeleteBtn) previewDeleteBtn.classList.add("hidden");
      if (previewStatus) previewStatus.textContent = "Reference image preview";
    }

    previewModal.classList.remove("hidden");
    previewModal.classList.add("flex");
  }

  function closeImagePreview(): void {
    if (previewModal) {
      previewModal.classList.add("hidden");
      previewModal.classList.remove("flex");
    }
    activePreviewTarget = null;
  }

  // Bind preview triggers
  document.querySelectorAll<HTMLElement>("[data-preview-image]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.stopPropagation();
      const src = el.dataset.src || (el.querySelector("img") as HTMLImageElement)?.src || "";
      const title = el.dataset.title || "Image Preview";
      const path = el.dataset.path || "";
      const part = el.dataset.part !== undefined ? Number(el.dataset.part) : undefined;
      const kind = el.dataset.kind as "start" | "end" | undefined;
      const value = el.dataset.value;
      const tileElement = el.closest<HTMLElement>("[data-tile-container]");
      const isProposal = path.includes("-proposal.jpg");

      openImagePreview(src, title, path, part, kind, value, tileElement, isProposal);
    });
  });

  previewCloseX?.addEventListener("click", closeImagePreview);
  previewCloseBtn?.addEventListener("click", closeImagePreview);
  previewModal?.addEventListener("click", (e) => {
    if (e.target === previewModal) closeImagePreview();
  });

  previewUseBtn?.addEventListener("click", () => {
    if (
      activePreviewTarget &&
      activePreviewTarget.part !== undefined &&
      activePreviewTarget.kind &&
      activePreviewTarget.value &&
      activePreviewTarget.tileElement
    ) {
      toggleTileSelection(
        activePreviewTarget.tileElement,
        activePreviewTarget.part,
        activePreviewTarget.kind,
        activePreviewTarget.value
      );
      closeImagePreview();
    }
  });

  // Handle Delete Proposal API calls
  async function performDeleteProposal(film: string, name: string, part: number, kind: "start" | "end") {
    if (!confirm(`Are you sure you want to delete the Part ${part} ${kind} proposal image?`)) {
      return;
    }
    try {
      const res = await fetch("/api/delete-proposal", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ film, name, part, kind }),
      });
      if (res.ok) {
        location.reload();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(`Failed to delete proposal: ${err.error || res.statusText}`);
      }
    } catch (err) {
      alert(`Failed to delete proposal: ${(err as Error).message}`);
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-delete-proposal]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const film = btn.dataset.film!;
      const name = btn.dataset.name!;
      const part = Number(btn.dataset.part);
      const kind = btn.dataset.kind as "start" | "end";
      void performDeleteProposal(film, name, part, kind);
    });
  });

  previewDeleteBtn?.addEventListener("click", () => {
    if (
      activePreviewTarget &&
      activePreviewTarget.part !== undefined &&
      activePreviewTarget.kind
    ) {
      const { part, kind } = activePreviewTarget;
      void performDeleteProposal(currentFilm, currentSceneName, part, kind);
    }
  });

  // Handle GENERATE video button per part
  document.querySelectorAll<HTMLButtonElement>("[data-generate-part]").forEach((button) => {
    button.addEventListener("click", () => {
      const film = button.dataset.film!;
      const name = button.dataset.name!;
      const part = Number(button.dataset.part);
      const state = partFrameState.get(part) ?? { frameStart: "", frameEnd: "" };

      const command = [
        `uv run animator --film ${film} --scene ${name} --parts ${part}`,
        state.frameStart ? `--frame_start ${state.frameStart}` : "",
        state.frameEnd ? `--frame_end ${state.frameEnd}` : "",
      ]
        .filter(Boolean)
        .join(" ");

      openCLITerminal({
        url: "/api/animator",
        body: {
          film,
          name,
          parts: part,
          frameStart: state.frameStart,
          frameEnd: state.frameEnd,
        },
        command,
      });
    });
  });

  // Keyframe Modal elements
  const keyframeModal = document.getElementById("keyframe-modal") as HTMLDivElement | null;
  const modalTitle = document.getElementById("keyframe-modal-title");
  const modalSubtitle = document.getElementById("keyframe-modal-subtitle");
  const modalCloseX = document.getElementById("keyframe-modal-close-x");
  const modalCancel = document.getElementById("keyframe-modal-cancel");
  const modalSubmit = document.getElementById("keyframe-modal-submit");
  const modalRefSelect = document.getElementById("keyframe-modal-ref-select") as HTMLSelectElement | null;
  const modalCustomRef = document.getElementById("keyframe-modal-custom-ref") as HTMLInputElement | null;
  const modalForce = document.getElementById("keyframe-modal-force") as HTMLInputElement | null;
  const modalCmdPreview = document.getElementById("keyframe-modal-cmd-preview");

  let activeModalPart = 0;
  let activeModalFilm = "";
  let activeModalName = "";

  function updateKeyframeCommandPreview(): void {
    if (!modalCmdPreview) return;
    const targetInput = document.querySelector<HTMLInputElement>(
      'input[name="keyframe-modal-target"]:checked'
    );
    const targetType = targetInput?.value || "start";
    const refVal = modalCustomRef?.value.trim() || modalRefSelect?.value || "";
    const force = modalForce?.checked || false;

    const cmd = [
      `uv run keyframes --film ${activeModalFilm} --scene ${activeModalName} --parts ${activeModalPart} --type ${targetType}`,
      refVal ? `--ref ${refVal}` : "",
      force ? "--force" : "",
    ]
      .filter(Boolean)
      .join(" ");

    modalCmdPreview.textContent = cmd;
  }

  function populateModalRefOptions(part: number, targetType: "start" | "end" | "both"): void {
    if (!modalRefSelect) return;
    modalRefSelect.innerHTML = "";

    const autoOpt = document.createElement("option");
    autoOpt.value = "";
    autoOpt.textContent = "Auto Discovery / None";
    modalRefSelect.appendChild(autoOpt);

    if (targetType === "end") {
      // Use whatever is selected for the first frame as the reference image
      const selectedStart = partFrameState.get(part)?.frameStart;
      if (selectedStart) {
        const opt = document.createElement("option");
        opt.value = selectedStart;
        opt.textContent = `Selected Start Frame (${selectedStart.split("/").pop()})`;
        opt.selected = true;
        modalRefSelect.appendChild(opt);
      } else {
        // Fallback: check if start proposal exists on the page
        const startTile = document.querySelector<HTMLElement>(
          `[data-frame-selector="start"][data-part="${part}"] [data-tile-container][data-value*="start-proposal"]`
        );
        const startPropVal = startTile?.dataset.value;
        if (startPropVal) {
          const opt = document.createElement("option");
          opt.value = startPropVal;
          opt.textContent = `Start Proposal (${startPropVal.split("/").pop()})`;
          opt.selected = true;
          modalRefSelect.appendChild(opt);
        }
      }
    } else if (targetType === "start") {
      if (part > 0) {
        const prevEndProp = `part-${part - 1}-end-proposal.jpg`;
        const prevEndOpt = document.createElement("option");
        prevEndOpt.value = prevEndProp;
        prevEndOpt.textContent = `Prior Part End Proposal (${prevEndProp})`;
        modalRefSelect.appendChild(prevEndOpt);
      }
    }
  }

  function openKeyframeModal(film: string, name: string, part: number, preselectedType: "start" | "end" | "both" = "start"): void {
    activeModalFilm = film;
    activeModalName = name;
    activeModalPart = part;

    if (modalTitle) modalTitle.textContent = `Generate Keyframe Proposal`;
    if (modalSubtitle) modalSubtitle.textContent = `Part ${part} · ${name}`;

    const radio = document.querySelector<HTMLInputElement>(
      `input[name="keyframe-modal-target"][value="${preselectedType}"]`
    );
    if (radio) radio.checked = true;

    populateModalRefOptions(part, preselectedType);
    if (modalCustomRef) modalCustomRef.value = "";
    if (modalForce) modalForce.checked = false;

    updateKeyframeCommandPreview();

    if (keyframeModal) {
      keyframeModal.classList.remove("hidden");
      keyframeModal.classList.add("flex");
    }
  }

  function closeKeyframeModal(): void {
    if (keyframeModal) {
      keyframeModal.classList.add("hidden");
      keyframeModal.classList.remove("flex");
    }
  }

  // Open keyframe modal triggers
  document.querySelectorAll<HTMLButtonElement>("[data-open-keyframe-modal]").forEach((btn) => {
    btn.addEventListener("click", () => {
      openKeyframeModal(btn.dataset.film!, btn.dataset.name!, Number(btn.dataset.part), "start");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-trigger-keyframe]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const type = (btn.dataset.triggerKeyframe as "start" | "end") || "start";
      openKeyframeModal(btn.dataset.film!, btn.dataset.name!, Number(btn.dataset.part), type);
    });
  });

  // Modal events
  modalCloseX?.addEventListener("click", closeKeyframeModal);
  modalCancel?.addEventListener("click", closeKeyframeModal);

  document.querySelectorAll('input[name="keyframe-modal-target"]').forEach((el) => {
    el.addEventListener("change", () => {
      const targetInput = document.querySelector<HTMLInputElement>(
        'input[name="keyframe-modal-target"]:checked'
      );
      const targetType = (targetInput?.value as "start" | "end" | "both") || "start";
      populateModalRefOptions(activeModalPart, targetType);
      updateKeyframeCommandPreview();
    });
  });
  modalRefSelect?.addEventListener("change", updateKeyframeCommandPreview);
  modalCustomRef?.addEventListener("input", updateKeyframeCommandPreview);
  modalForce?.addEventListener("change", updateKeyframeCommandPreview);

  modalSubmit?.addEventListener("click", () => {
    const targetInput = document.querySelector<HTMLInputElement>(
      'input[name="keyframe-modal-target"]:checked'
    );
    const targetType = (targetInput?.value as "start" | "end" | "both") || "start";
    const refVal = modalCustomRef?.value.trim() || modalRefSelect?.value || "";
    const force = modalForce?.checked || false;

    const command = [
      `uv run keyframes --film ${activeModalFilm} --scene ${activeModalName} --parts ${activeModalPart} --type ${targetType}`,
      refVal ? `--ref ${refVal}` : "",
      force ? "--force" : "",
    ]
      .filter(Boolean)
      .join(" ");

    closeKeyframeModal();

    openCLITerminal({
      url: "/api/keyframes",
      body: {
        film: activeModalFilm,
        name: activeModalName,
        parts: activeModalPart,
        type: targetType,
        ref: refVal,
        force,
      },
      command,
    });
  });
</script>
