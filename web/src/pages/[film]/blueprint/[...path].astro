---
import Layout from "../../../layouts/Base.astro";
import CLITerminal from "../../../components/CLITerminal.astro";
import {
  backgroundBlueprintDir,
  blueprintCommand,
  blueprintImageUrl,
  blueprintInfo,
  isValidFilm,
  loadMovie,
  slugify,
  subjectBlueprintDir,
} from "../../../lib/movie";

export const prerender = false;

const film = Astro.params.film ?? "";
if (!isValidFilm(film)) {
  return Astro.redirect("/");
}

const segments = (Astro.params.path ?? "")
  .split("/")
  .map((s) => s.trim())
  .filter(Boolean);

if (segments.length < 1 || segments.length > 2) {
  return Astro.redirect(`/${film}`);
}

const movie = loadMovie(film);
const [name, name2] = segments;
const character = movie.characters.find((c) => slugify(c.name) === name);
const scene = movie.scenes.find((s) => slugify(s.slug) === name);

let view:
  | {
      kind: "subject";
      title: string;
      subtitle: string;
      dir: string;
      relDir: string;
      target: { character?: string; scene?: string };
      note?: string;
      details: string;
    }
  | { kind: "scene-picker" }
  | null = null;

if (name2) {
  const background = scene?.backgrounds.find((b) => slugify(b.key) === name2);
  if (!scene || !background) {
    return Astro.redirect(`/${film}`);
  }
  view = {
    kind: "subject",
    title: `${scene.name} — ${background.key}`,
    subtitle: `scene background · ${scene.slug}/${background.key}`,
    dir: backgroundBlueprintDir(film, scene.slug, background.key),
    relDir: `${slugify(scene.slug)}/${slugify(background.key)}`,
    target: { scene: scene.slug },
    note: `Generating recreates all ${scene.backgrounds.length} background plate(s) for this scene.`,
    details: JSON.stringify(
      {
        scene: {
          name: scene.name,
          slug: scene.slug,
          logline: scene.logline,
        },
        background: background,
      },
      null,
      2,
    ),
  };
} else if (character) {
  view = {
    kind: "subject",
    title: character.name,
    subtitle: `character · ${slugify(character.name)}`,
    dir: subjectBlueprintDir(film, character.name),
    relDir: slugify(character.name),
    target: { character: character.name },
    details: JSON.stringify(character, null, 2),
  };
} else if (scene && scene.backgrounds.length === 1) {
  return Astro.redirect(`/${film}/blueprint/${slugify(scene.slug)}/${slugify(scene.backgrounds[0].key)}`);
} else if (scene) {
  view = { kind: "scene-picker" };
} else {
  return Astro.redirect(`/${film}`);
}

const info = view.kind === "subject" ? blueprintInfo(view.dir) : null;
const mainImage = info ? info.latest ?? info.style : null;
const thumbnails = info
  ? mainImage === info.latest
    ? info.attempts.slice(0, -1)
    : info.attempts
  : [];
const command = view.kind === "subject" ? blueprintCommand(film, view.target) : "";
---

<Layout film={film} title={view.kind === "subject" ? view.title : scene?.name ?? "Blueprint"}>
  <nav class="mb-4">
    <a
      href={`/${film}`}
      class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-muted ring-1 ring-line hover:text-amber-soft hover:ring-amber-key/40 transition-colors"
    >
      &larr; Back
    </a>
  </nav>

  {view.kind === "scene-picker" && scene && (
    <div class="rounded-xl border border-line bg-panel p-6 shadow-lg shadow-black/30">
      <h1 class="font-display text-2xl text-amber-soft">{scene.name}</h1>
      <p class="mt-1 font-mono text-sm text-muted">{scene.slug}</p>
      <p class="mt-4 text-sm text-slate-300">Pick a background plate:</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {scene.backgrounds.map((bg) => (
          <a
            href={`/${film}/blueprint/${slugify(scene.slug)}/${slugify(bg.key)}`}
            class="rounded-md bg-teal-shadow/10 px-3 py-1.5 text-sm text-teal-shadow ring-1 ring-teal-shadow/30 hover:bg-teal-shadow/20 transition-colors"
          >
            {bg.key}
          </a>
        ))}
      </div>
    </div>
  )}

  {view.kind === "subject" && (
    <div class="space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl text-amber-soft">{view.title}</h1>
          <p class="mt-1 font-mono text-sm text-muted">{view.subtitle}</p>
        </div>
        <div class="flex flex-col items-end gap-1.5">
          <div class="flex items-center gap-3">
            <label
              for="ignore-prev"
              class="flex cursor-pointer select-none items-center gap-1.5 text-[10px] text-muted"
              title="Start from a fresh initial prompt, ignoring the previous generation"
            >
              <input type="checkbox" id="ignore-prev" class="h-3 w-3 accent-amber-key" />
              ignore previous img
            </label>
            <button
              type="button"
              id="generate-btn"
              data-film={film}
              data-target={JSON.stringify(view.target)}
              title={command}
              class="rounded-md bg-amber-key/15 px-4 py-2 text-xs font-medium text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors"
            >
              {mainImage ? "Regenerate design" : "Generate design"}
            </button>
          </div>
          {view.note && <span class="max-w-56 text-right text-[10px] text-muted">{view.note}</span>}
        </div>
      </div>

      {mainImage ? (
        <figure class="overflow-hidden rounded-xl border border-line bg-panel shadow-lg shadow-black/30">
          <img
            src={blueprintImageUrl(film, view.relDir, mainImage)}
            alt={`${view.title} blueprint`}
            class="w-full"
          />
          <figcaption class="border-t border-line px-5 py-3 font-mono text-xs text-muted">
            films/{film}/out/blueprint/{view.relDir}/{mainImage}
          </figcaption>
        </figure>
      ) : (
        <div class="rounded-xl border border-dashed border-line bg-panel/50 px-6 py-16 text-center">
          <p class="text-sm text-muted">
            No blueprint generated yet. Run{" "}
            <code class="text-teal-shadow">{command}</code> or use the button above.
          </p>
        </div>
      )}

      {thumbnails.length > 0 && (
        <section>
          <h2 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">
            Previous attempts
          </h2>
          <div class="flex flex-wrap gap-2">
            {thumbnails.map((t) => (
              <a
                href={blueprintImageUrl(film, view.relDir, t)}
                target="_blank"
                rel="noreferrer"
                class="block overflow-hidden rounded-md ring-1 ring-line hover:ring-amber-key/50 transition"
                title={`films/${film}/out/blueprint/${view.relDir}/${t}`}
              >
                <img
                  src={blueprintImageUrl(film, view.relDir, t)}
                  alt={`${view.title} ${t}`}
                  class="h-20 w-auto"
                />
              </a>
            ))}
          </div>
        </section>
      )}

      <section>
        <h2 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">
          movie.yml details
        </h2>
        <textarea
          readonly
          rows={16}
          spellcheck={false}
          class="w-full resize-y rounded-lg border border-line bg-ink/40 p-3 font-mono text-xs leading-relaxed text-slate-300"
        >
          {view.details}
        </textarea>
      </section>
    </div>
  )}
</Layout>

<CLITerminal />

<script>
  import { openCLITerminal } from "../../../components/cli-terminal";

  const generateBtn = document.getElementById("generate-btn") as HTMLButtonElement | null;
  generateBtn?.addEventListener("click", () => {
    try {
      const film = generateBtn.dataset.film ?? "";
      const target = JSON.parse(generateBtn.dataset.target ?? "{}") as {
        character?: string;
        scene?: string;
      };
      const fresh = (document.getElementById("ignore-prev") as HTMLInputElement | null)?.checked ?? false;
      const flag = fresh ? " --new" : "";
      const command = target.character
        ? `uv run generate-blueprint --film ${film} --character "${target.character}"${flag}`
        : `uv run generate-blueprint --film ${film} --scene ${target.scene}${flag}`;
      openCLITerminal({
        url: "/api/generate-blueprint",
        body: fresh ? { film, ...target, new: true } : { film, ...target },
        command,
      });
    } catch {
      /* invalid target; ignore */
    }
  });
</script>
