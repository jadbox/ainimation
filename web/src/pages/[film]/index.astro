---
import Layout from "../../layouts/Base.astro";
import CLITerminal from "../../components/CLITerminal.astro";
import {
  animationFileUrl,
  filmAnimationFileUrl,
  filmVideo,
  hasAnimation,
  hasBlueprint,
  isValidFilm,
  loadMovie,
  sceneVideos,
  scriptStatus,
  slugify,
} from "../../lib/movie";

export const prerender = false;

const film = Astro.params.film ?? "";
if (!isValidFilm(film)) {
  return Astro.redirect("/");
}

const movie = loadMovie(film);
const mergedFilm = filmVideo(film);
const sceneNameBySlug = new Map(movie.scenes.map((s) => [s.slug, s.name]));

const rows = movie.story.map((story, index) => {
  const parts = scriptStatus(film, story.name);
  const blueprintSubjects = [...story.characters, story.scene];
  const blueprints = blueprintSubjects.map((subject) => ({
    subject,
    ready: hasBlueprint(film, subject),
  }));
  return {
    index,
    story,
    parts,
    partsDone: parts.filter(Boolean).length,
    blueprints,
    blueprintsDone: blueprints.filter((b) => b.ready).length,
    animated: hasAnimation(film, story.name),
    videos: sceneVideos(film, story.name),
    location: sceneNameBySlug.get(story.scene) ?? story.scene,
  };
});
---

<Layout film={film} title="Scenes">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-display text-2xl text-amber-soft">Story Scenes</h1>
      <p class="mt-1 text-sm text-muted">
        {movie.story.length} scene(s) from <code class="text-teal-shadow">films/{film}/movie.yml</code> ·
        scripts live in <code class="text-teal-shadow">films/{film}/out/scripts/</code>
      </p>
    </div>
    <p class="text-xs text-muted max-w-md">
      Generate scripts with <code class="text-teal-shadow">scriptgen</code>, then copy the
      <code class="text-teal-shadow">animator</code> command to run video generation in your terminal.
    </p>
  </div>

  <div class="w-fit rounded-xl border border-line bg-panel shadow-lg shadow-black/30">
    <table class="text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-muted">
          <th class="px-4 py-3 font-medium w-10">#</th>
          <th class="px-4 py-3 font-medium">Scene</th>
          <th class="px-4 py-3 font-medium">Location</th>
          <th class="px-4 py-3 font-medium">Characters</th>
          <th class="px-4 py-3 font-medium">Scripts</th>
          <th class="px-4 py-3 font-medium">Blueprints</th>
          <th class="px-4 py-3 font-medium">Videos</th>
          <th class="px-4 py-3 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr
              class="border-b border-line/60 last:border-b-0 hover:bg-panel-2/60 transition-colors"
              data-scene={row.story.name}
            >
              <td class="px-4 py-3 text-muted">
                <a
                  href={`/${film}/animate/${row.story.name}`}
                  title={`Configure animation generation for ${row.story.title}`}
                  class="transition-colors hover:text-amber-soft"
                >
                  {row.index}
                </a>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <a
                    href={`/${film}/animate/${row.story.name}`}
                    title={`Configure animation generation for ${row.story.title}`}
                    class="font-display text-base text-slate-100 transition-colors hover:text-amber-soft"
                  >
                    {row.story.title}
                  </a>
                  {row.animated && (
                    <span
                      class="rounded-full bg-teal-shadow/10 px-2 py-0.5 text-[10px] uppercase tracking-wide text-teal-shadow ring-1 ring-teal-shadow/30"
                      title={`films/${film}/out/animations/${row.story.name}/full.mp4 exists`}
                    >
                      video
                    </span>
                  )}
                </div>
                <div class="font-mono text-xs text-muted">{row.story.name}</div>
              </td>
              <td class="px-4 py-3">
                <a
                  href={`/${film}/blueprint/${slugify(row.story.scene)}`}
                  title={`Open ${row.location} background designs`}
                  class="text-slate-300 transition-colors hover:text-amber-soft"
                >
                  {row.location}
                </a>
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                  {row.story.characters.map((c) => (
                    <a
                      href={`/${film}/blueprint/${slugify(c)}`}
                      title={`Open ${c} design`}
                      class:list={[
                        "rounded-full px-2 py-0.5 text-xs ring-1 transition-colors",
                        hasBlueprint(film, c)
                          ? "bg-teal-shadow/10 text-teal-shadow ring-teal-shadow/25 hover:bg-teal-shadow/20"
                          : "bg-panel-2 text-muted ring-line hover:text-amber-soft hover:ring-amber-key/40",
                      ]}
                    >
                      {c}
                    </a>
                  ))}
                </div>
              </td>
              <td class="px-4 py-3" data-status>
                  {row.partsDone === row.parts.length ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs text-emerald-300 ring-1 ring-emerald-400/30">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" /> {row.partsDone}/{row.parts.length} ready
                  </span>
                ) : row.partsDone > 0 ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-key/10 px-2.5 py-1 text-xs text-amber-soft ring-1 ring-amber-key/30">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-key" /> {row.partsDone}/{row.parts.length} parts
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-500/10 px-2.5 py-1 text-xs text-muted ring-1 ring-slate-400/20">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-500" /> none
                  </span>
                )}
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-1" title={row.blueprints.map((b) => `${b.subject}: ${b.ready ? "ready" : "missing"}`).join("\n")}>
                  {row.blueprints.map((b) => (
                    <span
                      class:list={[
                        "h-2.5 w-2.5 rounded-full ring-1",
                        b.ready
                          ? "bg-emerald-400/80 ring-emerald-300/50"
                          : "bg-slate-600/60 ring-slate-500/40",
                      ]}
                      title={`${b.subject}: ${b.ready ? "ready" : "missing"}`}
                    />
                  ))}
                </div>
                <div class="mt-1 text-xs text-muted">
                  {row.blueprintsDone}/{row.blueprints.length}
                </div>
              </td>
              <td class="px-4 py-3">
                {row.videos.full === null && row.videos.segments.length === 0 ? (
                  <span class="text-xs text-muted/70">none</span>
                ) : (
                  <div class="flex items-center gap-2">
                    {row.videos.full && (
                      <a
                        href={`/${film}/video/${row.story.name}`}
                        title={`Full scene · films/${film}/out/animations/${row.story.name}/full.mp4`}
                        class="relative block w-20 overflow-hidden rounded-md ring-1 ring-line transition hover:ring-amber-key/50"
                      >
                        {row.videos.full.thumb ? (
                          <img
                            src={animationFileUrl(film, row.story.name, row.videos.full.thumb)}
                            alt={`Full scene ${row.story.name}`}
                            class="aspect-video w-full object-cover"
                            loading="lazy"
                          />
                        ) : (
                          <span class="flex aspect-video w-full items-center justify-center bg-ink/60 text-[9px] text-muted">full</span>
                        )}
                        <span class="absolute bottom-0 right-0 rounded-tl bg-black/70 px-2.5 py-0.5 text-[20px] uppercase tracking-wide text-amber-soft">full</span>
                      </a>
                    )}
                    {row.videos.segments.map((seg) => (
                      <a
                        href={`/${film}/video/${row.story.name}_part_${seg.part}`}
                        title={`Part ${seg.part} · films/${film}/out/animations/${row.story.name}/${seg.video}`}
                        class:list={[
                          "relative block overflow-hidden rounded-md ring-1 ring-line transition hover:ring-amber-key/50",
                          row.videos.full ? "w-15" : "w-20",
                        ]}
                      >
                        {seg.thumb ? (
                          <img
                            src={animationFileUrl(film, row.story.name, seg.thumb)}
                            alt={`Part ${seg.part} ${row.story.name}`}
                            class="aspect-video w-full object-cover"
                            loading="lazy"
                          />
                        ) : (
                          <span class="flex aspect-video w-full items-center justify-center bg-ink/60 text-[9px] text-muted">p{seg.part}</span>
                        )}
                        <span class="absolute bottom-0 right-0 rounded-tl bg-black/70 px-2.5 py-0.5 text-[20px] text-teal-shadow">p{seg.part}</span>
                      </a>
                    ))}
                  </div>
                )}
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-col items-end gap-1.5">
                  <div class="flex items-center justify-end gap-2">
                  {row.partsDone === row.parts.length && (
                    <a
                      href={`/${film}/scene/${row.story.name}`}
                      class="rounded-md bg-amber-key/15 px-3 py-1.5 text-xs font-medium text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors"
                    >
                      View scripts
                    </a>
                  )}
                  <details class="relative">
                    <summary class="cursor-pointer list-none rounded-md bg-amber-key/15 px-3 py-1.5 text-xs font-medium text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors">
                      {row.partsDone > 0 ? "Regenerate scripts" : "Create scripts"}
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-52 rounded-lg border border-line bg-panel p-3 shadow-xl shadow-black/40">
                      <label class="block text-xs text-muted">
                        Number of 10-second parts
                        <select data-parts-select class="mt-1.5 w-full rounded-md border border-line bg-panel-2 px-2 py-1.5 text-sm text-slate-200 outline-none focus:border-teal-shadow">
                          {Array.from({ length: 10 }, (_, index) => index + 1).map((parts) => (
                            <option value={parts} selected={parts === 3}>{parts}</option>
                          ))}
                        </select>
                      </label>
                      <button
                        type="button"
                        data-action="generate"
                        data-film={film}
                        data-name={row.story.name}
                        data-force={row.partsDone > 0 ? "true" : "false"}
                        class="mt-3 w-full rounded-md bg-teal-shadow/10 px-3 py-1.5 text-xs font-medium text-teal-shadow ring-1 ring-teal-shadow/30 hover:bg-teal-shadow/20 transition-colors"
                      >
                        Generate scripts
                      </button>
                    </div>
                  </details>
                  <a
                    href={`/${film}/animate/${row.story.name}`}
                    title={`Configure animation generation for ${row.story.title}`}
                    class="rounded-md px-3 py-1.5 text-xs font-mono text-teal-shadow ring-1 ring-teal-shadow/30 hover:bg-teal-shadow/10 transition-colors"
                  >
                    configure animate
                  </a>
                  </div>
                  {row.partsDone === row.parts.length && row.blueprintsDone === row.blueprints.length && (
                    <span
                      class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] uppercase tracking-wide text-emerald-300 ring-1 ring-emerald-400/30"
                      title="All scripts and blueprints are ready"
                    >
                      ready
                    </span>
                  )}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="mt-6 flex flex-wrap items-start gap-4 rounded-xl border border-line bg-panel/70 p-4 shadow-lg shadow-black/20">
    <div class="flex-1">
      <h2 class="font-display text-lg text-amber-soft">Full film</h2>
      <p class="mt-1 text-sm text-muted">Combine available scene <code>full.mp4</code> files in story order and extract a midpoint thumbnail.</p>
    </div>
    <button
      type="button"
      data-action="merge-film"
      data-film={film}
      class="rounded-md bg-amber-key/15 px-3 py-2 text-xs font-medium text-amber-soft ring-1 ring-amber-key/40 hover:bg-amber-key/25 transition-colors"
    >
      Merge all full scenes
    </button>
    {mergedFilm && (
      <a href={`/${film}/video/`} class="block w-40 overflow-hidden rounded-lg ring-1 ring-line transition hover:ring-amber-key/50" title="Watch full film">
        <img src={filmAnimationFileUrl(film, mergedFilm.thumb)} alt={`${movie.movie.title} full film`} class="aspect-video w-full object-cover" />
        <span class="block bg-panel-2 px-2 py-1 text-[10px] uppercase tracking-wide text-amber-soft">View film</span>
      </a>
    )}
  </section>

  <CLITerminal />
</Layout>

<script>
  import { openCLITerminal } from "../../components/cli-terminal";

  function runScriptgen(film: string, name: string, force: boolean, parts: number) {
    openCLITerminal({
      url: "/api/generate",
      body: { film, name, force, parts },
      command: `uv run scriptgen --film ${film} --name ${name} --parts ${parts}${force ? " --force" : ""}`,
    });
  }

  document.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
    if (!target) return;
    const action = target.dataset.action;
    const parts = Number(target.closest("details")?.querySelector<HTMLSelectElement>("[data-parts-select]")?.value ?? 3);
    if (action === "generate" && target.dataset.name && target.dataset.film) {
      runScriptgen(target.dataset.film, target.dataset.name, target.dataset.force === "true", parts);
    } else if (action === "merge-film" && target.dataset.film) {
      const command = `uv run python src/merge_film.py --film ${target.dataset.film}`;
      openCLITerminal({ url: "/api/merge-film", body: { film: target.dataset.film }, command });
    }
  });
</script>
