---
// Reusable confirmation dialog modal component. Include once in Layout (e.g. Base.astro)
// or on any page, then call confirmModal({ ... }) from any client script.
---

<div
  id="confirm-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="confirm-modal-title"
  aria-describedby="confirm-modal-message"
>
  <div class="flex w-full max-w-md flex-col overflow-hidden rounded-2xl border border-line bg-panel shadow-2xl transition-all">
    <div class="flex items-start gap-4 p-5">
      <div id="confirm-modal-icon" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-rose-500/10 ring-1 ring-rose-500/20">
        <svg class="h-6 w-6 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <div class="min-w-0 flex-1 pt-0.5">
        <div class="flex items-center justify-between gap-2">
          <h3 id="confirm-modal-title" class="font-display text-lg text-amber-soft">
            Are you sure?
          </h3>
          <button
            type="button"
            id="confirm-modal-close-x"
            class="rounded p-1 text-muted hover:text-slate-200 transition-colors cursor-pointer"
            aria-label="Close"
          >
            &times;
          </button>
        </div>
        <p id="confirm-modal-message" class="mt-2 text-sm text-slate-300 leading-relaxed">
          Are you sure you want to proceed with this action?
        </p>
        <p id="confirm-modal-details" class="mt-2 text-xs text-muted leading-relaxed font-mono hidden">
        </p>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2.5 border-t border-line bg-ink/50 px-5 py-3.5">
      <button
        type="button"
        id="confirm-modal-cancel-btn"
        class="rounded-md px-3.5 py-2 text-xs font-medium text-muted ring-1 ring-line hover:text-slate-200 hover:ring-slate-400 transition-colors cursor-pointer"
      >
        Cancel
      </button>
      <button
        type="button"
        id="confirm-modal-confirm-btn"
        class="rounded-md bg-rose-600/20 px-4 py-2 text-xs font-semibold text-rose-300 ring-1 ring-rose-500/50 hover:bg-rose-600/30 transition-colors cursor-pointer"
      >
        Confirm
      </button>
    </div>
  </div>
</div>

<script>
  import { initConfirmModal } from "./confirm-modal";
  initConfirmModal();
</script>
